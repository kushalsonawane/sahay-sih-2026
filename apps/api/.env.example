NODE_ENV=production
PORT=10000

# SQLite database (file-based for demo prototype)
DATABASE_URL="file:./dev.db"

# JWT secrets — use strong random strings in production
JWT_SECRET=sahay-sih-demo-jwt-secret-change-in-production
JWT_REFRESH_SECRET=sahay-sih-demo-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — frontend domain or wildcard
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
