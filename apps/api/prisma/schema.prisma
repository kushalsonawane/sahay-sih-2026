// Prisma Schema — SAHAY Backend
// Smart India Hackathon Prototype
// Database: SQLite (demo). For production, change provider to "postgresql"
// and update DATABASE_URL in .env

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---- Users ----
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // UserRole enum as string
  district     String?
  state        String?
  language     String   @default("en")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCases        Case[]         @relation("AssignedOfficer")
  counselledCases      Case[]         @relation("AssignedCounsellor")
  checkInReviews       CheckIn[]      @relation("Reviewer")
  ownedAlerts          Alert[]        @relation("AlertOwner")
  assignedInterventions Intervention[] @relation("AssignedPerson")
  approvedInterventions Intervention[] @relation("ApprovedBy")
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
}

// ---- Refresh Tokens ----
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

// ---- Cases ----
model Case {
  id                     String   @id @default(cuid())
  caseRef                String   @unique
  personNameMasked       String
  personInitials         String
  district               String
  state                  String
  block                  String?
  caseStage              String   // CaseStage enum as string
  caseType               String   // CaseType enum as string
  assignedOfficerId      String?
  assignedOfficer        User?    @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  assignedCounsellorId   String?
  assignedCounsellor     User?    @relation("AssignedCounsellor", fields: [assignedCounsellorId], references: [id])
  riskLevel              String   // RiskLevel enum as string
  distressScore          Float    @default(0)
  trend                  String   @default("unknown")
  lastCheckIn            DateTime?
  lastContact            DateTime?
  nextAction             String?
  nextActionDue          DateTime?
  checkInCompletionRate  Float    @default(0)
  dataConfidence         String   @default("limited")
  dataFreshnessHours     Float    @default(0)
  privacyMasked          Boolean  @default(true)
  consentGiven           Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  checkIns      CheckIn[]
  alerts        Alert[]
  interventions Intervention[]
  appointments  Appointment[]
  auditLogs     AuditLog[]     @relation("CaseAuditLogs")
  timeline      TimelineEvent[]
}

// ---- Check-Ins ----
model CheckIn {
  id                  String   @id @default(cuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submittedAt         DateTime
  channel             String
  completionStatus    String
  distressIndicator   Float
  riskLevel           String
  consentGiven        Boolean
  responses           String   // JSON string
  humanReviewStatus   String   @default("pending")
  reviewerId          String?
  reviewer            User?    @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedAt          DateTime?
  flaggedForEscalation Boolean @default(false)
  createdAt           DateTime @default(now())
}

// ---- Alerts ----
model Alert {
  id                  String   @id @default(cuid())
  caseId              String
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  alertType           String
  severity            String
  triggerDescription  String
  detectedAt          DateTime
  ownerId             String?
  owner               User?    @relation("AlertOwner", fields: [ownerId], references: [id])
  recommendedAction   String
  slaDue              DateTime
  status              String   @default("new")
  resolvedAt          DateTime?
  resolutionNote      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---- Interventions ----
model Intervention {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  interventionType  String
  reason            String
  priority          String
  assignedDept      String
  assignedPersonId  String?
  assignedPerson    User?    @relation("AssignedPerson", fields: [assignedPersonId], references: [id])
  dueDate           DateTime
  status            String   @default("pending")
  approvalStatus    String   @default("pending")
  approvedById      String?
  approvedBy        User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---- Appointments ----
model Appointment {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  counsellorName String
  scheduledAt    DateTime
  type           String
  status         String   @default("scheduled")
  notes          String?
  createdAt      DateTime @default(now())
}

// ---- Timeline Events ----
model TimelineEvent {
  id                String   @id @default(cuid())
  caseId            String
  case              Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventType         String
  title             String
  description       String
  date              DateTime
  channel           String?
  distressIndicator Float?
  riskLevel         String?
  outcome           String?
  flagged           Boolean  @default(false)
  createdAt         DateTime @default(now())
}

// ---- Audit Logs ----
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  actor         User     @relation(fields: [actorId], references: [id])
  action        String
  resourceType  String
  resourceId    String
  caseId        String?
  case          Case?    @relation("CaseAuditLogs", fields: [caseId], references: [id])
  resourceLabel String?
  reason        String?
  ipAddress     String
  timestamp     DateTime @default(now())
}
